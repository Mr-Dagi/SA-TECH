{
  "info": {
    "name": "Portfolio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Local Postman collection for the portfolio backend API. Start the server with npm run dev:server before using."
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Get Site Settings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/site-settings",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "site-settings"]
        }
      }
    },
    {
      "name": "Get Projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/projects",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "projects"]
        }
      }
    },
    {
      "name": "Get Blogs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/blogs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "blogs"]
        }
      }
    },
    {
      "name": "Get Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:4000/api/messages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "messages"]
        }
      }
    },
    {
      "name": "Create Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dagi\",\n  \"email\": \"dagi@example.com\",\n  \"message\": \"Test message via Postman.\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/messages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "messages"]
        }
      }
    }
  ]
}
